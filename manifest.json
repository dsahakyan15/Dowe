{
  "manifest_version": 3,
  "name": "Dowe",
  "short_name": "Dowe",
  "description": "Select any text, get an instant AI explanation — as fast as a dove.",
  "version": "0.1.0",
  "action": {
    "default_popup": "src/dictionary/dictionary.html",
    "default_title": "Dowe — understanding, delivered instantly",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/selection-icon.js",
        "src/content/result-popup.js",
        "src/content/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/lib/strings.js", "src/lib/storage.js", "src/styles/shared.css", "icons/*.png", "icons/logo.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["storage", "activeTab", "scripting", "commands", "contextMenus"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "commands": {
    "trigger-lookup": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "Look up the current selection with Dowe"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
